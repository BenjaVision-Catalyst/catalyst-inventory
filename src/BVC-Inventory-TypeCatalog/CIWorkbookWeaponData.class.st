{ #category : 'registration' }
CIWorkbookWeaponData class >> registerCapacitorCoreOverrideIn: catalog [
	| weapon named source attribute cap |
	weapon := catalog typeAt: 'weapon.launch.capacitor'.
	named := catalog weaponReferenceAt: 'Weapons Named + Exotics!C113'.
	source := named evidenceForField: #exoticMods.
	cap := CIAttributeValue
			status: #documented
			raw: '12%'
			magnitude: 0.12
			unit: #fraction
			evidence: source.
	attribute := CIAttributeDefinition
			id: 'weapon.variant.capacitor.damageToArmor'
			label: 'Damage to armor'
			context: #weaponClassCore
			group: 'Fixed secondary core'
			values: {#standardMaximum -> cap} asDictionary
			notes: #().
	catalog attributeCatalogue register: attribute.
	weapon
		classGenerationRule: (CIWeaponClassGenerationRule
				weaponClass: #assaultRifle
				attribute: attribute
				stat: 'damageToArmor'
				label: 'Damage to armor'
				innateHeadshotDamage: weapon classGenerationRule innateHeadshotDamage
				evidence: source)
]

{ #category : 'registration' }
CIWorkbookWeaponData class >> registerExoticMinorRulesIn: catalog [
	| definitions |
	definitions := catalog attributeCatalogue definitionsIn: #weaponMinor.
	catalog weaponReferences
		do: [ :reference | 
			| typeId minor exclusions |
			typeId := reference itemDefinitionIdentifier.
			minor := reference fieldAt: #minor.
			(reference kind = #exotic
				and: [ typeId notNil
						and: [ #('Any Basic' 'Any Basic (Excluding Damage to Armor)') includes: minor ] ])
				ifTrue: [ exclusions := minor = 'Any Basic (Excluding Damage to Armor)'
							ifTrue: [ #('weapon.minor.damageToArmor') ]
							ifFalse: [ #() ].
					(catalog typeAt: typeId)
						minorAttributeRule: (CIExoticWeaponMinorRule
								basicAttributes: definitions
								excluding: exclusions
								evidence: (reference evidenceForField: #minor)) ] ]
]

{ #category : 'registration' }
CIWorkbookWeaponData class >> registerFirstSightReloadIn: catalog [
	| weapon statistics reload |
	weapon := catalog typeAt: 'weapon.workbook.firstSight'.
	statistics := weapon statisticsReference.
	reload := CIWeaponFixedAttribute
			fromWorkbookRow: {'emptyReloadSeconds'.
					'Empty reload time (s)'.
					(statistics fieldAt: #emptyReloadSeconds) asNumber.
					#seconds.
					#intrinsic.
					#always}
			evidence: (statistics evidenceForField: #emptyReloadSeconds).
	weapon fixedAttributes: weapon fixedAttributes , {reload}
]

{ #category : 'registration' }
CIWorkbookWeaponData class >> registerFixedMountNotesIn: catalog [
	#(#('C63' 'C63' muzzle #(#(stability percent 0.30)) nil) #('C64' 'C63' muzzle #(#(stability percent 0.30)) nil) #('C70' 'C70' optics #(#(criticalHitChance percent 0.05)) 'attachment.workbook8') #('C71' 'C70' optics #(#(criticalHitChance percent 0.05)) nil) #('C72' 'C70' optics #(#(criticalHitChance percent 0.05)) nil))
		do: [ :row | 
			| target original attachment |
			target := catalog weaponReferenceAt: 'Weapons!' , row first.
			original := catalog weaponReferenceAt: 'Weapons!' , row second.
			attachment := row fifth
					ifNotNil: [ :id | catalog modCatalogue definitionAt: id ].
			target
				addFixedMount: (CIWeaponFixedMount
						slot: row third
						effects: row fourth
						evidence: (original evidenceForField: #columnP)
						inheritedEvidence: (target == original
								ifFalse: [ target evidenceForField: #columnP ])
						attachment: attachment) ]
]

{ #category : 'registration' }
CIWorkbookWeaponData class >> registerFixedNamedWeaponItemsIn: catalog [
	#(#('C8' 'C4' 'firstSight' #('innateHeadshotDamage' 'Innate headshot damage' 0.85 fraction intrinsic always) headshotDamage) #('C142' 'C49' 'slingshot' #('optimalRangeMetres' 'Optimal range (m)' 60 metres intrinsic always) optimalRangeMetres) #('C165' 'C59' 'backupBoomstick' #('weaponDamage' 'Shotgun damage' 0.17 fraction primaryCore always)) #('C195' 'C64' 'theMop' #('armorOnKill' 'Armor on kill' 0.10 fraction secondary always)) #('C269' 'C76' 'theWhiteDeath' #('headshotDamage' 'Headshot damage' 1.37 fraction secondary always)) #('C268' 'C77' 'ohCarol' #('headshotDamage' 'Headshot damage' 1.37 fraction secondary always)) #('C318' 'C97' 'tdiKardCustom' #('skillTier' 'Skill tier while active' 1 count secondary whileActiveWeapon)))
		do: [ :row | 
			| statistics named weapon typeId |
			statistics := catalog weaponReferenceAt: 'Weapons!' , row first.
			named := catalog weaponReferenceAt: 'Weapons Named + Exotics!' , row second.
			typeId := 'weapon.workbook.' , row third.
			statistics linkItemDefinition: typeId.
			named linkItemDefinition: typeId.
			weapon := row third = 'backupBoomstick'
					ifTrue: [ CIWorkbookNamedWeaponType
							statistics: statistics
							named: named
							slot: 'LeftHandWeapon' ]
					ifFalse: [ CIWorkbookNamedWeaponType statistics: statistics named: named ].
			weapon
				fixedAttributes: {CIWeaponFixedAttribute
							fromWorkbookRow: row fourth
							evidence: (row fourth fifth = #intrinsic
									ifTrue: [ statistics evidenceForField: row fifth ]
									ifFalse: [ named evidenceForField: #talentOrAttribute ])}.
			catalog register: weapon ].
	self registerFirstSightReloadIn: catalog
]

{ #category : 'registration' }
CIWorkbookWeaponData class >> registerIn: catalog [
	#(statsPart1 statsPart2 statsPart3 statsPart4 statsPart5 statsPart6 statsPart7 statsPart8 statsPart9 statsPart10 statsPart11 statsPart12 statsPart13 statsPart14 statsPart15 statsPart16)
		do: [ :selector | 
			(self perform: selector)
				do: [ :row | 
					catalog
						registerWeaponReference: (CIWeaponWorkbookReference fromWorkbookRow: row sheet: 'Weapons') ] ].
	#(namedPart1 namedPart2 namedPart3 namedPart4 namedPart5 namedPart6 namedPart7 namedPart8)
		do: [ :selector | 
			(self perform: selector)
				do: [ :row | 
					catalog
						registerWeaponReference: (CIWeaponWorkbookReference fromWorkbookRow: row sheet: 'Weapons Named + Exotics') ] ].
	self registerSupportedNamedWeaponsIn: catalog.
	self registerFixedMountNotesIn: catalog
]

{ #category : 'registration' }
CIWorkbookWeaponData class >> registerPerfectlyExtraIn: catalog [
	catalog
		registerTalent: (CIItemTalent
				id: 'perfectlyExtra'
				name: 'Perfectly Extra'
				eligibility: #weapon
				parameters: {#magazineCapacityBonus -> 0.50.
						#evidence -> 'Weapons Named + Exotics!E52'} asDictionary
				comment: 'Increases magazine capacity by 50%.')
]

{ #category : 'registration' }
CIWorkbookWeaponData class >> registerSheriffIn: catalog [
	| statistics named weapon typeId source |
	typeId := 'weapon.workbook.theSheriff'.
	statistics := catalog weaponReferenceAt: 'Weapons!C192'.
	named := catalog weaponReferenceAt: 'Weapons Named + Exotics!C146'.
	statistics linkItemDefinition: typeId.
	named linkItemDefinition: typeId.
	weapon := CIWorkbookNamedWeaponType statistics: statistics named: named.
	source := named evidenceForField: #talentOrAttribute.
	weapon
		fixedAttributes: (#(#('builtInWeaponDamageBonus' 'Built-in Weapon Damage bonus' 0.35 fraction intrinsic always) #('builtInAccuracyBonus' 'Built-in Accuracy bonus' 1 fraction intrinsic always))
				collect: [ :row | CIWeaponFixedAttribute fromWorkbookRow: row evidence: source ]);
		disableDamageFalloff.
	catalog register: weapon
]

{ #category : 'registration' }
CIWorkbookWeaponData class >> registerSupportedNamedWeaponSourcesIn: catalog [
	#(#('namedWeapons.lightZone' 'LZ' zone #('C17' 'C45')) #('namedWeapons.darkZone' 'DZ' zone #('C26')) #('namedWeapons.shieldSplinterer' 'Ivory Cache / then Cassie Mendoza' acquisitionRoute #('C8')))
		do: [ :spec | 
			| entries |
			entries := spec fourth
					collect: [ :address | 
						| reference |
						reference := catalog
								weaponReferenceAt: 'Weapons Named + Exotics!' , address.
						CILootPoolEntry
							item: (catalog typeAt: reference itemDefinitionIdentifier)
							weight: nil
							requiring: nil
							evidence: (reference evidenceForField: #acquisition) ].
			CIGameItemTypes
				registerLootPool: spec first
				name: spec second
				kind: spec third
				entries: entries
				in: catalog ]
]

{ #category : 'registration' }
CIWorkbookWeaponData class >> registerSupportedNamedWeaponsIn: catalog [
	self registerPerfectlyExtraIn: catalog.
	self registerUnwaveringIn: catalog.
	#(#('C17' 'C8' 'perfectOptimist') #('C53' 'C17' 'perfectInSync') #('C87' 'C26' 'perfectFastHands') #('C150' 'C45' 'perfectPreservation') #('C159' 'C52' 'perfectlyExtra' 'weapon.workbook.rockNRoll') #('C134' 'C42' 'perfectUnwavering.swapChain' 'weapon.workbook.swapChain'))
		do: [ :spec | 
			| statistics named weapon |
			statistics := catalog weaponReferenceAt: 'Weapons!' , spec first.
			named := catalog weaponReferenceAt: 'Weapons Named + Exotics!' , spec second.
			(spec at: 4 ifAbsent: [ nil ])
				ifNotNil: [ :identifier | 
					statistics linkItemDefinition: identifier.
					named linkItemDefinition: identifier ].
			statistics itemDefinitionIdentifier = named itemDefinitionIdentifier
				ifFalse: [ self error: 'Named weapon statistics link differs from detail link' ].
			weapon := CIWorkbookNamedWeaponType statistics: statistics named: named.
			catalog register: weapon.
			catalog talentPool: {spec third} for: weapon id ].
	self registerSupportedNamedWeaponSourcesIn: catalog
]

{ #category : 'registration' }
CIWorkbookWeaponData class >> registerUnwaveringIn: catalog [
	#(#('unwavering' 'Unwavering' 3 'Weapon Talents!B54:D54') #('perfectUnwavering.swapChain' 'Perfect Unwavering' 4 'Weapons Named + Exotics!E42'))
		do: [ :row | 
			catalog
				registerTalent: (CIItemTalent
						id: row first
						name: row second
						eligibility: #weapon
						parameters: {#weaponHandling -> row third.
								#durationSeconds -> 5.
								#swapAwayLockoutSeconds -> 5.
								#killsRefresh -> true.
								#evidence -> row fourth} asDictionary
						comment: 'Swapping to this weapon grants +' , (row third * 100) asString
								, '% weapon handling for 5 seconds. Kills refresh the buff. Swapping away disables Unwavering on all weapons for 5 seconds.') ]
]

{ #category : 'registration' }
CIWorkbookWeaponData class >> registerVariantGenerationRulesIn: catalog [
	self registerFixedNamedWeaponItemsIn: catalog.
	self registerSheriffIn: catalog.
	self registerCapacitorCoreOverrideIn: catalog.
	self registerExoticMinorRulesIn: catalog
]

