	^ #(#('C105' 'Eagle Bearer' assaultRifle exotic nil #(#(weaponClassLabel 'Assault Rifle' 'A100') #(variant 'P416 G3' 'B104') #(name 'Eagle Bearer' 'C105') #(talentOrAttribute 'Eagle Strike  / Accuracy increases as you continuously fire, up to 30%. /  / Headshot kills grant the Tenacity buff for 15 seconds. /  / The strength of Tenacity is increased by 1% for body shots and 5% for headshots.  /  / Tenacity / 40-80% of damage taken is delayed until the buff expires. /  / All of the total delayed damage is reduced for each enemy killed while the buff is active, up to 100% with 3 kills.' 'E104') #(exoticMods 'Optics: +15% Critical Hit Chance / Magazine: +30 Rounds / Muzzle: +20% Critical Hit Damage / Underbarrel: +10% Weapon Handling' 'F104') #(minor 'Any Basic' 'G104') #(acquisition '- Operation Dark Hours  /       (Normal ONLY) / - Low Chance per DH Boss / - End cache 10% / - Extremely Low chance from DZ  /' 'I104') #(flavour 'Inscription reads: / "For tireless defense and service in the wake of our shared national tragedy, we present this to Odessa Sawyer. May she always rise to meet the challenges in her path." / - The People of the Theatre settlement /  / - Despite the belief of some that the Eagle Bearer is an M4, its firerate and closer inspection of the gun body reveal that it is an exact match for the P416 G3. / - Since Odessa Sawyer used to serve The Division alongside Agent Kelso, the faction associated with this weapon is the SHD. / - "Rise to meet the challenges" is actually a pun referring to the SHD phoenix logo, which Odessa identifies strongly with.' 'J104'))) #('C107' 'St. Elmo''s Engine' assaultRifle exotic nil #(#(weaponClassLabel 'Assault Rifle' 'A100') #(variant 'LVOA-C' 'B106') #(name 'St. Elmo''s Engine' 'C107') #(talentOrAttribute 'Actum Est / Shooting an enemy with this weapon will give 1 stack.  /  / At 100 stacks the next magazine will be 100% filled with shock ammo.' 'E106') #(exoticMods 'Optics: +15% Critical Damage / Magazine: +30 Rounds / Muzzle: +15% Critical Hit chance / Underbarrel: +10% Weapon Handling' 'F106') #(minor 'Any Basic' 'G106') #(acquisition '- Year 5 Season 1 track /  / -- Target loot / -- Exotic Caches' 'I106') #(flavour '"Sometimes the most beautiful and dangerous phenomenon is natural." / anonymous' 'J106'))) #('C109' 'The Bighorn' assaultRifle exotic nil #(#(weaponClassLabel 'Assault Rifle' 'A100') #(variant 'Aug A3-CQC' 'B108') #(name 'The Bighorn' 'C109') #(talentOrAttribute 'Big Game Hunter / When scoped, switches to semi-automatic fire mode, dealing 450% weapon damage with each shot. /  / Headshots grant +6% headshot damage. Stacks up to 25 times. Once at full stacks, 10 stacks decay every 4 seconds until all stacks have been removed. Headshots delay decaying of stacks.' 'E108') #(exoticMods 'Optics: +40% Headshot Damage / Magazine: +20% Reload Speed / Muzzle: +20% Accuracy / Underbarrel: +20% Stability' 'F108') #(minor 'Any Basic' 'G108') #(acquisition '- Legendary bosses (5%) / - Extremely Low chance from DZ' 'I108') #(flavour '"Take aim. Take a breath. Steady yourself. Concentrate. Exhale. Squeeze." /  / - The Bighorn''s flavour text is not attributed to any character. / - Further research of the Bighorn reveals that the bighorn sheep is a species of sheep that lives in certain mountainous areas of North America. / - These states and geographical areas are what you see traced into the faction logo of The Bighorn.' 'J108'))) #('C111' 'Strega' assaultRifle exotic nil #(#(weaponClassLabel 'Assault Rifle' 'A100') #(variant 'FAL' 'B110') #(name 'Strega' 'C111') #(talentOrAttribute 'Talent Unnerve / Killing an enemy will apply a mark on every enemy within 20m of it. Multiple marks can be applied to the same enemy. Max number of marks that can be applied to an enemy is 5. all marks on an enemy will disappear 10s after the last one has been applied. Deal +15% Amplified Damage per mark to marked enemies.' 'E110') #(exoticMods 'Magazine: +20 Rounds / Muzzle: +5% Critical Hit Damage / Optics: +5% Critical Hit Chance / Underbarrel: +10% Weapon Handling' 'F110') #(minor 'Any Basic' 'G110') #(acquisition '-- Target loot / -- Exotic Caches' 'I110') #(flavour '"this is no longer about prevention. It''s about damage control." / - Colonel Antwon Ridgeway' 'J110'))) #('C113' 'Capacitor' assaultRifle exotic 'weapon.launch.capacitor' #(#(weaponClassLabel 'Assault Rifle' 'A100') #(variant 'PDR' 'B112') #(name 'Capacitor /' 'C113') #(talentOrAttribute 'Capacitance / Shooting enemies builds stacks to a cap of 40. Each stack grants 1.5% Skill Damage. After 5 seconds, stacks decay 1 per second. /  / For each skill tier gain 7.5% Weapon Damage.' 'E112') #(exoticMods 'Main attributes:  12% Damage to Armour /  / Optics: +10% Critical Hit Chance / Magazine: +11 Rounds / Muzzle: +30% Critical Hit Damage / Underbarrel: +10% Weapon Handling' 'F112') #(minor 'Any Basic (Excluding Damage to Armor)' 'G112') #(acquisition '- The Summit challenges /  / After acquiring blueprint / -- Target loot / -- Exotic Caches' 'I112') #(flavour '"My two favourite things are: cut and crossed wires, and electric fires. Luckily those  two tend to go hand in hand. Let''s spark it up, then burn it down." / - Former Black Tusk technician /  / - Gee, I wonder why he''s no longer a technician with the Black Tusk.' 'J112'))) #('C114' 'Agitator' assaultRifle exotic nil #(#(weaponClassLabel 'Assault Rifle' 'A100') #(variant 'F2000' 'B114') #(name 'Agitator' 'C114') #(talentOrAttribute 'Perturb / While this weapon is holstered, generate 50% less Threat when shooting. Keeping this weapon holstered for 10s will Prime it. /  / While primed, swapping to this weapon grants +25% Rate of Fire, +30% Weapon Damage and you generate 100% more Threat when Shooting for 20s. /  / Swapping from this weapon before the timer ends removes the bonuses.' 'E114') #(exoticMods 'Optics: +10% Critical Hit Chance / Magazine: +20 Rounds / Muzzle: +50% Swap Speed' 'F114') #(minor 'Any Basic' 'G114') #(acquisition 'Y8S1 Season pass' 'I114') #(flavour 'When they least expect it.' 'J114'))) #('C117' 'Bullet King' lmg exotic nil #(#(weaponClassLabel 'LMG' 'A116') #(variant 'IWI-NEGEV' 'B116') #(name 'Bullet King' 'C117') #(talentOrAttribute 'Bullet Hell / This weapon never needs to be reloaded. /  / For every 100 bullets that hit an enemy, replenish some ammo to you and all your allies'' reserves.' 'E116') #(exoticMods 'Magazine: Mag of Holding / Muzzle: +15% Critical Hit chance / Underbarrel: +20% Stability' 'F116') #(minor 'Any Basic' 'G116') #(acquisition '- Rikers bosses /  / -- Target loot / -- Exotic Caches' 'I116') #(flavour '"Pour one out for my bro. If he''d used this, he''d never have run out of bullets."  / - The Bullet Queen /  / -For Bullet King, this replenishes 100 bullets since the hidden mag size is 100 / - Despite this flavour text, the Bullet King can in fact run out of bullets. The Bullet King does not have to reload and replenishes some ammo every 100 hits, but this / does not mean that it has an infinite reserve of ammo. Note that the Bullet King is NOT the best in slot LMG. The best LMG for DPS play is an MG5 or Infantry MG5  / with Fast Hands, which has a much higher DPS than Bullet King while having only slighly lower DPM. / - This weapon is a tribute to a Division 1 Rikers boss who had to be removed from the game after he was farmed a little too efficiently.' 'J116'))) #('C118' 'Big Alejandro' lmg exotic nil #(#(weaponClassLabel 'LMG' 'A116') #(variant 'M249/MK46 /  / CETME Ameli / MG42 Barrel' 'B118') #(name 'Big Alejandro' 'C118') #(talentOrAttribute 'Cover Shooter / Every bullet fired while in cover increases weapon damage by 1% up to 100%. The bonus lasts for 15 seconds. /  / Getting a kill with this weapon while in cover resets the duration. /  / The bonus damage is canceled by reloading, swapping weapons, or exiting combat.' 'E118') #(exoticMods 'None' 'F118') #(minor 'Any Basic' 'G118'))) #('C121' 'Bluescreen' lmg exotic 'weapon.launch.bluescreen' #(#(weaponClassLabel 'LMG' 'A116') #(variant 'Stoner LAMG' 'B120') #(name 'Bluescreen' 'C121') #(talentOrAttribute '/ Disruptor Rounds / Shooting an enemy marks that enemy and adds a stack to the agent up to a count of 50. Shooting a marked enemy refreshes the mark and adds stacks to the agent. When you deploy a non-shield skill, remove all stacks on agent and all marked targets trigger an effect.  /  / 1 - 10 Stacks - Pulse marked targets for 5 seconds  / 11 - 25 Stacks - Pulse and Disrupt marked targets for 5 seconds.  / 26 - 49 Stacks - Pulse, Disrupt, and Disorient marked targets for 5 seconds.  / 50 Stacks - Pulse, Disrupt, and Disorient marked targets and all hostiles within 10 meters of the marked targets for 5 seconds. This effect will trigger immediately if any marked enemy is killed.' 'E120') #(exoticMods 'Optics: +20% Reload speed / Magazine: +15% Weapon Handling / Muzzle: +20% Rate of fire / Underbarrel: +10% Stability' 'F120') #(minor 'Any Basic' 'G120') #(acquisition '/ - Season 9 Track /  / -- Target loot / -- Exotic Caches' 'I120') #(flavour '"Cause of death? ... User Error."' 'J120'))) #('C123' 'Iron Lung' lmg exotic nil #(#(weaponClassLabel 'LMG' 'A116') #(variant 'MG5' 'B122') #(name 'Iron Lung' 'C123') #(talentOrAttribute '/ Ardent / Shooting heats up the weapon, filling up heat meter. The meter is equivalent to 50% of the weapon''s standard Magazine Size. /  / When the meter is full, rounds shot by the weapon will ignite enemies. /  / When not shooting, the meter depletes over time. Reloading or swapping the weapon fully depletes the meter.' 'E122') #(exoticMods 'Optics: +10% Critical Hit Damage / Magazine: +35 Rrounds / Underbarrel: +10% Critical Hit Damage' 'F122') #(minor 'Any Basic' 'G122') #(acquisition '-- Target loot / -- Exotic Caches' 'I122') #(flavour '"Arson is a made-up crime. Some people deserve to burn." / - The Arsoninst' 'J122'))) #('C124' 'Pakhan' lmg exotic nil #(#(weaponClassLabel 'LMG' 'A116') #(variant 'RPK' 'B124') #(name 'Pakhan' 'C124') #(talentOrAttribute '/ Pakhan / Each kill with this weapon gains a stack of 75% Base Magazine Size increase to the next magazine, up to 4 stacks.' 'E124') #(exoticMods 'Optics: +15% Wapon Damage / Magazine: +20 Rounds / Muzzle: +15% Critical Hit chance / Underbarrel: +10% Reload Speed' 'F124') #(minor 'Any Basic' 'G124') #(acquisition '- Year 7 Season 1 track /  / -- Target loot / -- Exotic Caches' 'I124') #(flavour '"Pack another one of those big mags"' 'J124'))) #('C127' 'Pestilence' lmg exotic nil #(#(weaponClassLabel 'LMG' 'A116') #(variant 'M249' 'B126') #(name 'Pestilence' 'C127') #(talentOrAttribute 'Plague of the Outcasts  / Hits apply a debuff dealing 100% weapon damage over 10s. This stacks up to 50 times. /  / Whenever an enemy dies with this debuff, the stacks are transferred to a nearby enemy within 25m.' 'E126') #(exoticMods 'Magazine: +10% Rate of Fire / Muzzle: +10% Accuracy / Underbarrel: +10% Stability' 'F126') #(minor 'Any Basic' 'G126') #(acquisition '- DZ Landmark boss / - DZ Roaming boss 1% /  / -- Target loot / -- Exotic Caches' 'I126') #(flavour '"You will suffer as we suffered"  / -  Formerly Quarantined Outcast /  / - Even though the Plague of the Outcasts acts like a status effect, it is actually a debuff and cannot be spread by the Eclipse Protocol gearset / (unless the gearset kills an enemy which has the debuff, in which case it spreads on death as per normal). / - The fact that this debuff doesn''t work with Eclipse Protocol makes even less sense considering that both are inspired by viruses.' 'J126'))) #('C129' 'Backfire' smg exotic nil #(#(weaponClassLabel 'SMG' 'A128') #(variant 'MPX' 'B128') #(name 'Backfire' 'C129') #(talentOrAttribute 'Payment in kind / Dealing damage to enemies adds a stack of 2% Critical Hit Damage, up to 100 stacks, lasting 10s. /  / On reload apply a 10s bleed to yourself, which deals 0.5% armor damage per stack.' 'E128') #(exoticMods 'Optics: +15% Critical Hit Chance / Magazine: +20 Rounds / Muzzle: +15% Critical Hit Damage / Underbarrel: +10% Stability' 'F128') #(minor 'Any Basic' 'G128') #(acquisition '- Season 3 track /  / -- Target loot / -- Exotic Caches' 'I128') #(flavour '"For only those who have suffered may decree the suffering of others!"  /  / -  Outcast Creed /  / - In the first Division game, the most coveted SMG was The House. It was used on DPS builds. It''s entirely possible that the Backfire will become a new meta SMG. / - Harming oneself in order to do maximum harm to others is nothing new to the Outcasts. All their combat tactics, from suicide bombers to molotov cocktails / revolve around this. A gun that does massive damage in exchange for causing you to bleed is business as usual. / - Reloading with Ninjabike Kneepads prevents the gun from causing bleed.' 'J128'))) #('C131' 'The Chatterbox' smg exotic 'weapon.launch.chatterbox' #(#(weaponClassLabel 'SMG' 'A128') #(variant 'FN P90' 'B130') #(name 'The Chatterbox' 'C131') #(talentOrAttribute 'Incessant Chatter / When you reload, rate of fire is increased by 25% for each enemy within 15m for the duration of that magazine. /  / Max stacks: 5 /  / Kills refill 50% of your magazine.' 'E130') #(exoticMods 'Optics: +15% Critical Hit Chance / Magazine: +10 Rounds / Muzzle: +15% Critical Hit Damage / Underbarrel: +10% Weapon Handling' 'F130') #(minor 'Any Basic' 'G130') #(acquisition '- Hyena Cache questline /  / After acquiring blueprint / -- Target loot / -- Exotic Caches' 'I130') #(flavour '"They say I never know when to shut the hell up, but that''s just the spice talking"  / - Dime, Hyenas Councilmember /  / - Full name: The Lost Chatterbox / - Blueprint flavor text: "Zip it and let your gun do the talking" / - Spice is a drug manufactured by the Hyenas. It causes euphoria, aggression and loss of bodily sensation. Dime is addicted to spice. / - Dime''s most iconic voice line is "Diesel are you dead too you inbred son of a bitch?"' 'J130'))) #('C133' 'Lady Death' smg exotic nil #(#(weaponClassLabel 'SMG' 'A128') #(variant 'CMMG Banshee' 'B132') #(name 'Lady Death' 'C133') #(talentOrAttribute 'Breathe Free  / When moving, gain 4 stacks per second, or 8 stacks if sprinting. Max stack is equal to the weapon''s Magazine Size. /  / Each round fired consumes a stack, amplifying damage by 75%. /  / Kills grant +20% movement speed for 10s.' 'E132') #(exoticMods 'Optics: +15% Critical Hit Chance / Magazine: +10% Reload Speed / Muzzle: 10% Critical Hit Damage / Underbarrel: +500% Melee Damage' 'F132') #(minor 'Any Basic' 'G132') #(acquisition '- 22 NY open world bosses (3%) /  / -- Target loot / -- Exotic Caches' 'I132') #(flavour '"Can''t take our freedom? That''s a lie. Your freedom can always be taken. The only thing standing between you and tyranny is the barrel of your gun"  / - 2A Enthusiast /  / - The Second Amendment, 2A for short, gives United States citizens the right to bear arms. In pure principle, having guns gives citizens the power to overthrow a  / corrupt government. Lady Liberty is also present on the gun, a symbol of freedom and independence. / - The faction logo for this gun was originally going to be the United States flag, but it was more appropriate to make the flag that of New York. Specifically, a  / redesigned New York City flag from r/vexillology' 'J132'))) #('C135' 'Ouroboros' smg exotic nil #(#(weaponClassLabel 'SMG' 'A128') #(variant 'Vector' 'B134') #(name 'Ouroboros' 'C135') #(talentOrAttribute '/ Rule them all / When the agent has a Status Effect applied to them, 50% of the ammo in their next magazine will apply the same Status Effect to their targets. /  / This effect will only occur during combat.' 'E134') #(exoticMods 'Optics: +10% Critical Hit Damage / Magazine: +25% Reload Speed / Muzzle: +10% Rate of Fire / Underbarrel: +10% Critical Hit Chance' 'F134') #(minor 'Any Basic' 'G134') #(acquisition '- Incursions Chest 10%. / - Incursions Boss drop 1%' 'I134') #(flavour '"What goes around, inevitably comes around." / - Aaron "Vanguard" Keener' 'J134'))) #('C136' 'Underboss /  / (PTS)' smg exotic nil #(#(weaponClassLabel 'SMG' 'A128') #(variant 'Tommy Gun' 'B136') #(name 'Underboss /  / (PTS)' 'C136') #(talentOrAttribute 'Gangland Hit /  / Shooting an enemy with this weapon applies a mark. You can only apply one mark at a time. Shooting another enemy will transfer the mark. /  / More marks can be applied on the same enemy by other agents using this weapon. Maximum amount of marks that can be applied on an enemy is 4. /  / This weapon deals +20% Amplified Damage to marked enemies. The bonus is increased by 5% for each extra mark on the enemy other than your own.' 'E136') #(exoticMods 'None' 'F136') #(minor 'Any Basic' 'G136') #(release 'TU 28' 'H136'))) #('C138' 'Oxpecker' smg exotic nil #(#(weaponClassLabel 'SMG' 'A128') #(variant 'MP7' 'B138') #(name 'Oxpecker' 'C138') #(talentOrAttribute '/ Symbiosis / While having a Shield deployed, lose Shield Health at a rate of 10% per second. / Your Shield recieves repairs of 25% of the damage dealt by this weapon.' 'E138') #(exoticMods 'Optics: +50% Optimal Range / Muzzle: +10 Rounds / Underbarrel: +15% Critical Hit Chance' 'F138') #(minor 'Any Basic' 'G138') #(acquisition '- Year 6 Season 3 track /  / -- Target loot / -- Exotic Caches' 'I138') #(flavour '"The healing is less rewarding than the hurting, but i''m content."' 'J138'))) #('C141' 'Lullaby' shotgun exotic nil #(#(weaponClassLabel 'Shotgun' 'A140') #(variant 'SPAS-12' 'B140') #(name 'Lullaby' 'C141') #(talentOrAttribute 'Sandman / Melee attacks instantly kill non-elite enemies. /  / Cooldown: 15s.' 'E140') #(exoticMods 'Optics: +15% Accuracy / Magazine: +15% Reload Speed / Underbarrel: 25% Optimal Range' 'F140') #(minor 'Any Basic' 'G140') #(acquisition 'Pre-Order / OR buy Deluxe Pack with / Premium Credits' 'I140') #(flavour '"Sleep tight, motherfucker"  / - Roach, Hyenas Councilmember /  / - Even though the alternate version of this gun is dropped by the Outcasts, the instakill device on this gun is said to be "rigged by the Hyenas". / - In addition to this, the flavour text on this gun refers to Roach, the boss of Bank Headquarters.' 'J140'))) #('C143' 'Sweet Dreams' shotgun exotic nil #(#(weaponClassLabel 'Shotgun' 'A140') #(variant 'SPAS-12' 'B142') #(name 'Sweet Dreams' 'C143') #(talentOrAttribute 'Sandman / Melee attacks instantly kill non-elite enemies. /  / Cooldown: 15s.' 'E142') #(exoticMods 'Optics: +15% Accuracy / Muzzle: +15% Reload Speed / Underbarrel: +25% Optimal Range' 'F142') #(minor 'Any Basic' 'G142') #(acquisition '- Outcast bosses /  / -- Target loot / -- Exotic Caches' 'I142') #(flavour '"Who are you to disagree?"  / - Unknown Outcast Engineer /  / -The name of the weapon and its description are reference to Eurythmics, their song titled "Sweet Dreams (are made of this). The unknown outcast engineer follows with the next line. / - Despite being dropped by the Outcasts and having a flavour text relating to the Outcasts, the instakill device on this gun is said to be "rigged by the Hyenas". / - Do not use this gun to do damage, as it has a very low headshot damage modifier. / - Lore-wise, it makes sense that the Hyenas and Outcasts share a hatred for the True Sons. The True Sons are hated by the Hyenas for being a superior force, and the Outcasts  / want vengeance on the True Sons for their crimes on Roosevelt Island. There is even an echo where Hyenas and Outcasts are seen raiding a True Sons base in tandem.' 'J142'))))
]

{ #category : 'workbook data' }
CIWorkbookWeaponData class >> namedPart7 [
	^ #(#('C145' 'Overlord' shotgun exotic nil #(#(weaponClassLabel 'Shotgun' 'A140') #(variant 'KSG' 'B144') #(name 'Overlord' 'C145') #(talentOrAttribute 'Capitulate / Hitting an enemy applies -4% Movement Speed for each pellet hit for 5 seconds. Shooting the enemy again will reapply the stacks.' 'E144') #(exoticMods 'Optics Slot: 15% Critical Hit Damage /  / Magazine Slot: +15% Reload Speed /  / Underbarrel Slot: +20% Weapon Stability /  /' 'F144') #(minor 'Any Basic' 'G144') #(acquisition '-- Target loot / -- Exotic Caches' 'I144') #(flavour '"If this is what it takes to make them submit, so be it." / - Dime' 'J144'))) #('C146' 'The Sheriff' shotgun exotic nil #(#(weaponClassLabel 'Shotgun' 'A140') #(variant 'Super 90' 'B146') #(name 'The Sheriff' 'C146') #(talentOrAttribute 'Autentico +35 Weapon Damage. +100% accuracy. No Damage Drop Off. These bonus are built into the weapons base stats' 'E146') #(exoticMods 'None' 'F146') #(minor 'Any Basic' 'G146'))) #('C149' 'Scorpio' shotgun exotic 'weapon.launch.scorpio' #(#(weaponClassLabel 'Shotgun' 'A140') #(variant 'SIX12' 'B148') #(name 'Scorpio' 'C149') #(talentOrAttribute 'Septic Shock / Shooting a target applies stacks of venom, which last for 10s. Increasing stacks adds more severe debuffs to the target. /  / 2 - Poison / 4 - Disorient  / 6 - Shock  / 9 - Target takes additional 20% damage (from all sources). Stacks no longer increase. /  / Duration of Status Effects is based on percentage of pellets hit on applying shot. /  / Editor''s note: The 20% damage taken debuff actually starts applying on stack 8. Stack 9 refreshes the duration.' 'E148') #(exoticMods 'Optics: +10% critical hit chance  / Magazine: +10% Reload Speed / Muzzle: +10% Stability / Underbarrel: +10% Weapon Handling' 'F148') #(minor 'Any Basic' 'G148') #(acquisition '- Season 4 track /  / -- Target loot / -- Exotic Caches' 'I148') #(flavour 'This weapon fires debilitating venomous rounds inspired by the scorpion (specifically Hottentotta). The weapon developed in conjunction with DARPA failed to get approval due to it being in contravention of the Hague Convention of 1899.' 'J148'))) #('C151' 'Ruthless' rifle exotic nil #(#(weaponClassLabel 'Rifle' 'A150') #(variant 'AKM' 'B150') #(name 'Ruthless' 'C151') #(talentOrAttribute 'Binary Trigger / This weapon fires on trigger pull and release. /  / If both bullets hit the same enemy, gain a stack. /  / At 7 stacks, shooting an enemy deals 500% amplified damage and creates a 7m explosion dealing 500% weapon damage, consuming the stacks.' 'E150') #(exoticMods 'Optics: +15% Accuracy / Magazine: +10% Reload Speed / Muzzle: +15% Stability / Underbarrel: +15% Weapon Handling' 'F150') #(minor 'Any Basic' 'G150') #(acquisition 'Pre-Order / OR buy Deluxe Pack with / Premium Credits' 'I150') #(flavour '"Maintaining power requires one to be ruthless. Absolutely ruthless."  / - Mayhem, Hyena Councilmember /  / - The Hyenas are an organisation of street gangs. Nothing more has to be said here.' 'J150'))) #('C153' 'Merciless' rifle exotic nil #(#(weaponClassLabel 'Rifle' 'A150') #(variant 'AKM' 'B152') #(name 'Merciless' 'C153') #(talentOrAttribute 'Binary Trigger / This weapon fires on trigger pull and release. /  / If both bullets hit the same enemy, gain a stack. /  / At 7 stacks, shooting an enemy deals 500% amplified damage and creates a 7m explosion dealing 500% weapon damage, consuming the stacks.' 'E152') #(exoticMods 'Optics: +15% Accuracy / Magazine: +10% Reload Speed / Muzzle: +15% Stability / Underbarrel: +15% Weapon Handling' 'F152') #(minor 'Any Basic' 'G152') #(acquisition '- Hyena bosses /  / -- Target loot / -- Exotic Caches' 'I152') #(flavour '"Some people say I lack empathy. They''re wrong. What I lack is mercy."  / - Zodiac, Hyenas Councilmember /  / - Currently, the low damage of this gun combined with its poor handling make it one of the lest desirable exotics.' 'J152'))) #('C155' 'Diamondback' rifle exotic nil #(#(weaponClassLabel 'Rifle' 'A150') #(variant '1886.0' 'B154') #(name 'Diamondback' 'C155') #(talentOrAttribute 'Agonizing Bite / Diamondback randomly marks an enemy within 20m. If no enemies are within 20m, it marks the enemy closest to you. /  / Hitting that enemy consumes the mark, guaranteeing a critical hit with damage amplified by 20%.  /  / After hitting a mark, all shots fired are guaranteed critical hits for 5 seconds.  /  / A new random enemy is marked afterwards and whenever you reload.' 'E154') #(exoticMods 'Optics: +10% Accuracy / Magazine: +10% Reload Speed / Muzzle: +15% Critical Hit Damage / Underbarrel: +10% stability' 'F154') #(minor 'Any Basic' 'G154') #(acquisition '- Kenly College end cache / - (Can be obtained once per / expedition opening) /  / -- Target loot / -- Exotic Caches' 'I154') #(flavour '"I don''t give a damn if it''s not an actual Diamondback. I''ll call it whatever I want, and I like the name."  / - Manning National Zoo Reptile Keeper /  / - Manning National Zoo is based on the Smithsonian National Zoo, hence the faction logo is an inverted Smithsonian logo. / - Kenly College is propsed to be an ingame substitute for Howard University' 'J154'))) #('C157' 'Doctor Home' rifle exotic 'weapon.launch.doctorHome' #(#(weaponClassLabel 'Rifle' 'A150') #(variant 'M1A CQB' 'B156') #(name 'Doctor Home' 'C157') #(talentOrAttribute 'Doctor Home / Shooting an enemy with this weapon will apply a mark for 5 seconds. / If a marked target is killed it will give a 10% armor repair kit which applies to the whole party. / The kit will not give bonus armor.' 'E156') #(exoticMods 'Optics: +10% Accuracy / Magazine: +10% Reload Speed / Muzzle: +10% Stability / Underbarrel: +10% Weapon Handling' 'F156') #(minor 'Any Basic' 'G156') #(acquisition '- Season 10 Manhunt Reward /  / -- Target loot / -- Exotic Caches' 'I156') #(flavour '"A house isn''t a home until you can defend it." 13' 'J156'))) #('C158' 'Bittersweet' rifle exotic nil #(#(weaponClassLabel 'Rifle' 'A150') #(variant 'Classic M1A' 'B158') #(