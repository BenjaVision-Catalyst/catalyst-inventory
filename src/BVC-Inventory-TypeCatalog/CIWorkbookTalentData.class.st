{ #category : 'registration' }
CIWorkbookTalentData class >> registerCalculatedIn: catalog [
	#(#('calculated' 'Calculated' 0.10 'Kills from cover reduce Gadget cooldowns by 10%.') #('perfectlyCalculated' 'Perfectly Calculated' 0.15 'Kills from cover reduce Gadget cooldowns by 15%.'))
		do: [ :row | 
			catalog
				registerTalent: (CIItemTalent
						id: row first
						name: row second
						eligibility: #Backpack
						parameters: {#cooldownReductionFraction -> row third} asDictionary
						comment: row fourth) ]
]

{ #category : 'registration' }
CIWorkbookTalentData class >> registerEnergizeRulesIn: catalog [
	| standard perfect |
	standard := CIEnergizeRule cooldownSeconds: 60 evidence: 'Gear Talents!D44:F44'.
	perfect := CIEnergizeRule
			cooldownSeconds: 30
			evidence: 'Gear Talents!D44:F44; Gear Named + Exotics!F23:G23'.
	(catalog talentReferenceAt: 'Gear Talents!D44')
		gadgetTalentRule: standard
		perfect: perfect.
	(catalog namedGearReferenceAt: 'Axel') gadgetTalentRule: perfect
]

{ #category : 'registration' }
CIWorkbookTalentData class >> registerIn: catalog [
	#(weaponPart1 weaponPart2 weaponPart3 weaponPart4 weaponPart5)
		do: [ :selector | 
			(self perform: selector)
				do: [ :row | 
					catalog
						registerTalentReference: (CIWorkbookTalentReference fromWorkbookRow: row sheet: 'Weapon Talents') ] ].
	#(gearPart1 gearPart2 gearPart3 gearPart4)
		do: [ :selector | 
			(self perform: selector)
				do: [ :row | 
					catalog
						registerTalentReference: (CIWorkbookTalentReference fromWorkbookRow: row sheet: 'Gear Talents') ] ].
	self registerEnergizeRulesIn: catalog.
	self registerTagTeamIn: catalog.
	self registerCalculatedIn: catalog.
	self registerSkilledIn: catalog
]

{ #category : 'registration' }
CIWorkbookTalentData class >> registerSkilledIn: catalog [
	| pvpSource |
	pvpSource := {'Gear Talents!K21'
				-> 'Skill kills have a 🔴20% 🔴(25%) chance to reset skill CDs.'} asDictionary.
	#(#('skilled' 'Skilled' 0.25 0.20 'Gadget kills have a 25% chance to reset Gadget cooldowns (20% in DZ/PvP).') #('perfectlySkilled' 'Perfectly Skilled' 0.30 0.25 'Gadget kills have a 30% chance to reset Gadget cooldowns (25% in DZ/PvP).'))
		do: [ :row | 
			| talent |
			talent := CIItemTalent
					id: row first
					name: row second
					eligibility: #Chest
					parameters: {#gadgetCooldownResetChance -> row third} asDictionary
					comment: row fifth
							, ' If no Gadget is on cooldown, a successful roll banks one reset for the next Gadget to go on cooldown.'.
			talent
				modeProfile: (CITalentModeProfile
						status: #documented
						parameters: {#gadgetCooldownResetChance -> row fourth} asDictionary
						sources: pvpSource)
				for: #pvp.
			catalog registerTalent: talent ]
]

{ #category : 'registration' }
CIWorkbookTalentData class >> registerTagTeamIn: catalog [
	catalog
		registerTalent: (CIItemTalent
				id: 'tagTeam'
				name: 'Tag Team'
				eligibility: #Chest
				parameters: {#cooldownReductionSeconds -> 6.
						#cooldownSeconds -> 4} asDictionary
				comment: 'Gadget damage marks the last enemy damaged. Weapon damage consumes the mark to reduce active Gadget cooldowns by 6 seconds. Cooldown: 4 seconds.')
]

{ #category : 'registration' }
CIWorkbookTalentData class >> registerTamperProofIn: catalog [
	| pvpSources |
	pvpSources := {'Gear Talents!H24' -> 'Arm time: 5 seconds'.
			'Gear Talents!K24'
				-> 'Arm time: 3 seconds. Cooldown per Skill: 10 seconds (8 Seconds).'.
			'TUY8S3.2 PvP rebalance, page 5'
				-> 'Revised radius: 4 metres. Arming: 2 seconds. Cooldown: 15 seconds (10 Perfect). Decoy is Perfect only.'}
			asDictionary.
	#(#('tamperProof' 'Tamper Proof' Chest 10 15 false 'Enemies entering 3 metres of your deployed Hive, Turret or Remote Pulse are shocked. Arming: 2 seconds. Cooldown per Gadget: 10 seconds.') #('perfectlyTamperProof' 'Perfectly Tamper Proof' Backpack 8 10 true 'Enemies entering 3 metres of your deployed Hive, Turret, Remote Pulse or Decoy are shocked. Arming: 2 seconds. Cooldown per Gadget: 8 seconds.'))
		do: [ :row | 
			| talent |
			talent := CIItemTalent
					id: row first
					name: row second
					eligibility: row third
					parameters: {#shockRadiusMetres -> 3.
							#armSeconds -> 2.
							#cooldownSeconds -> row fourth.
							#allowsDecoy -> row sixth} asDictionary
					comment: row seventh.
			talent
				modeProfile: (CITalentModeProfile
						status: #documented
						parameters: {#shockRadiusMetres -> 4.
								#cooldownSeconds -> row fifth} asDictionary
						sources: pvpSources)
				for: #pvp.
			catalog registerTalent: talent ]
]

{ #category : 'registration' }
CIWorkbookTalentData class >> registerTechSupportIn: catalog [
	#(#('techSupport' 'Tech Support' 25 'Gadget kills increase total Gadget damage by 25% for 25 seconds.') #('perfectTechSupport' 'Perfect Tech Support' 27 'Gadget kills increase total Gadget damage by 25% for 27 seconds.'))
		do: [ :row | 
			catalog
				registerTalent: (CIItemTalent
						id: row first
						name: row second
						eligibility: #Backpack
						parameters: {#skillDamageOnGadgetKill -> 0.25.
								#durationSeconds -> row third} asDictionary
						comment: row fourth) ]
]

