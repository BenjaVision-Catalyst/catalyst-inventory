Class {
	#name : 'CIWorkbookFamilyData',
	#superclass : 'Object',
	#category : 'BVC-Inventory-TypeCatalog',
	#package : 'BVC-Inventory-TypeCatalog'
}

{ #category : 'registration' }
CIWorkbookFamilyData class >> bonusFrom: record [
	| modifier |
	modifier := CIGearModifier
			stat: record first
			operation: #add
			magnitude: record second
			targetClass: nil
			duration: #whileEquipped.
	modifier unit: record third.
	^ modifier
]

{ #category : 'accessing' }
CIWorkbookFamilyData class >> brandIdentifierFor: name [
	^ 'brand.workbook.'
		, (name asLowercase select: [ :each | each isAlphaNumeric ]) asString
]

