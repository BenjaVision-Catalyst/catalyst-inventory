{ #category : 'registration' }
CIWorkbookFamilyData class >> registerIn: catalog [
	self brandRows
		do: [ :record | 
			| identifier |
			identifier := self brandIdentifierFor: record first.
			catalog
				registerGearFamilyReference: (CIGearFamilyWorkbookReference
						name: record first
						kind: #brand
						fields: record second
						runtimeFamily: identifier).
			catalog
				registerGearFamily: (CIGearFamily
						id: identifier
						manufacturer: record first
						tiers: (record third collect: [ :tier | self brandTierFrom: tier ])) ].
	self classifiedRows
		do: [ :record | 
			catalog
				registerGearFamilyReference: (CIGearFamilyWorkbookReference
						name: record first
						kind: #gearSet
						fields: record third
						runtimeFamily: record second) ]
]
