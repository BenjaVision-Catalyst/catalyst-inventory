{ #category : 'registration' }
CIWorkbookFamilyData class >> brandTierFrom: record [
	| tier |
	tier := CIGearFamilyTier
			pieces: record first
			modifiers: {self bonusFrom: record second}
			trigger: nil
			consumeOn: nil
			limit: 1.
	tier pvpModifiers: {self bonusFrom: record third} evidence: record fourth.
	^ tier
]

