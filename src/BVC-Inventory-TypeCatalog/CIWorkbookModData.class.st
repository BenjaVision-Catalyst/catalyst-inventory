{ #category : 'workbook data' }
CIWorkbookModData class >> gearModEffectsFor: spec [
	| effects |
	effects := {{spec first asSymbol.
				spec third}}.
	spec last = 43
		ifTrue: [ effects := effects
					copyWith: #(referenceText 'Types: Fire, Bleed, Shock & Disrupt, Blind & Deaf, Disorient & Ensare') ].
	^ effects
]

{ #category : 'workbook data' }
CIWorkbookModData class >> gearMods [
	^ #(#('criticalHitChance' 'Critical Hit Chance' percent 0.06 38) #('criticalHitDamage' 'Critical Hit Damage' percent 0.12 39) #('headshotDamage' 'Headshot Damage' percent 0.10 40) #('protectionFromElites' 'Protection from Elites' percent 0.13 41) #('armorOnKill' 'Armour on Kill' flat 18935 42) #('statusEffectResistance' 'Status Effect Resistance' percent 0.10 43) #('pulseResistance' 'Pulse Resistance' percent 0.10 44) #('incomingRepairs' 'Incoming Repairs' percent 0.20 45) #('skillHaste' 'Skill Haste' percent 0.12 46) #('skillDuration' 'Skill Duration' percent 0.10 47) #('repairSkills' 'Repair Skills' percent 0.20 48))
]

{ #category : 'registration' }
CIWorkbookModData class >> registerIn: catalogue [
	self weaponAttachments
		do: [ :spec | 
			| definition restriction |
			restriction := (#('attachment.workbook8' 'attachment.workbook72')
					includes: spec first) ifTrue: [ spec at: 7 ].
			definition := CIModDefinition
					id: spec first
					name: spec second
					kind: spec third
					interfaces: spec fourth
					models: #()
					effects: (spec at: 6)
					maximum: nil
					tierCaps: Dictionary new
					evidence: spec last
					acquisition: (restriction ifNil: [ spec at: 7 ]).
			definition workbookMount: spec fifth modelRestriction: restriction.
			catalogue register: definition ].
	self gearMods
		do: [ :spec | 
			catalogue
				register: (CIModDefinition
						id: 'gearMod.' , spec first
						name: spec second
						kind: #gearMod
						interfaces: #(gearMod)
						models: #()
						effects: (self gearModEffectsFor: spec)
						maximum: spec fourth
						tierCaps: Dictionary new
						evidence: 'Attribute Info!E' , spec last asString
						acquisition: nil) ].
	self factoryAttachments
		do: [ :weapon | 
			weapon third
				do: [ :attachment | 
					| identifier |
					identifier := weapon first , '.factory.' , attachment first.
					catalogue
						register: (CIModDefinition
								id: identifier
								name: attachment first capitalized
								kind: #factoryAttachment
								interfaces: #()
								models: {weapon first}
								effects: attachment second
								maximum: nil
								tierCaps: Dictionary new
								evidence: weapon second
								acquisition: nil).
					catalogue
						registerSocket: (CIItemSocket
								id: attachment first
								interface: nil
								fixedMod: identifier)
						forItem: weapon first ] ]
]

