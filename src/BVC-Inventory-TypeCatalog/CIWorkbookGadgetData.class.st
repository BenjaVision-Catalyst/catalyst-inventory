{ #category : 'registration' }
CIWorkbookGadgetData class >> registerExpertiseRulesIn: catalog [
	| skillRule |
	skillRule := catalog attributeCatalogue ruleAt: 'expertise.skill'.
	#(#('Smart Cover' 'Precision' 15 'Duration' false) #('Smart Cover' 'Fortified' 21 'Bonus Armor' false) #('Sticky Bomb' 'Burn' 28 'Burn damage' true) #('Sticky Bomb' 'EMP' 34 'EMP / Blast Radius' false) #('Sticky Bomb' 'Explosive' 38 'Damage' true) #('Trap' 'Shock' 43 'Shock Duration' false) #('Trap' 'Healing' 49 'Repair' false) #('Trap' 'Shrapnel' 55 'Damage' true) #('Decoy' 'Holographic Distraction' 61 'Threat' false) #('Pulse' 'Scanner' 65 'Duration' false) #('Pulse' 'Remote' 69 'Effect Radius' false) #('Pulse' 'Jammer (EMP)' 72 'Radius' false) #('Pulse' 'Achilles' 76 nil true) #('Pulse' 'Banshee' 80 'Disorient Duration' false) #('Turret' 'Assault' 85 'Damage' true) #('Turret' 'Incinerator' 90 'Damage' true) #('Turret' 'Sniper' 100 'Damage' true) #('Turret' 'Artillery' 107 'Damage' true) #('Hive' 'Restorer' 117 'Duration' false) #('Hive' 'Stinger' 125 'Damage' true) #('Hive' 'Reviver' 136 'Range' false) #('Hive' 'Booster' 143 'Buff Amount' false) #('Hive' 'Artificer' 151 'Buff Amount' false) #('Chem Launcher' 'Reinforcer' 161 'Cloud Duration' false) #('Chem Launcher' 'Firestarter' 169 'Damage' true) #('Chem Launcher' 'Riot Foam' 178 'Foam Health' false) #('Chem Launcher' 'Oxidizer' 184 'Cloud Damage' true) #('Firefly' 'Blinder' 190 'Blind Duration' false) #('Firefly' 'Burster' 196 'Damage' true) #('Firefly' 'Demolisher' 201 'Damage' true) #('Seeker' 'Explosive' 207 'Damage' true) #('Seeker' 'Airburst' 215 'Damage' true) #('Seeker' 'Cluster' 223 'Damage' true) #('Seeker' 'Mender' 229 'Healing' false) #('Drone' 'Striker' 236 'Damage' true) #('Drone' 'Defender' 241 'Damage Reduction' false) #('Drone' 'Bombardier' 246 'Explosion Damage' true) #('Drone' 'Fixer' 252 'Duration' false) #('Drone' 'Tactician' 257 'Scan Range' false) #('Shield' 'Bulwark' 261 'Active / Regeneration' false) #('Shield' 'Crusader' 266 'Active  / Regeneration' false) #('Shield' 'Deflector' 271 'Active / Regeneration' false) #('Shield' 'Striker' 277 'Active / Regeneration' false))
		do: [ :row | 
			| variant raw operation ruleClass rule |
			variant := (catalog gadgetFamilyNamed: row first) variantNamed: row second.
			raw := variant expertiseScaling first copyAfter: $+.
			row fourth ifNotNil: [ :label | variant trackNamed: label ].
			operation := row fifth
					ifTrue: [ skillRule expertiseOperationForVariant: variant name ].
			ruleClass := (row first = 'Pulse' and: [ row second = 'Achilles' ])
					ifTrue: [ CIAchillesPulseExpertiseScaling ]
					ifFalse: [ (row first = 'Hive' and: [ row second = 'Artificer' ])
							ifTrue: [ CIArtificerExpertiseScaling ]
							ifFalse: [ CIGadgetExpertiseScaling ] ].
			ruleClass = CIArtificerExpertiseScaling ifTrue: [ operation := #additive ].
			rule := ruleClass
					stat: (raw copyAfter: $%) trimBoth
					track: row fourth
					operation: operation
					fractionPerGrade: (raw copyUpTo: $%) asNumber / 100
					evidence: 'Skill List!M' , row third asString.
			ruleClass = CIArtificerExpertiseScaling
				ifTrue: [ rule buffAmountTrack: (variant trackNamed: row fourth) ].
			variant expertiseRule: rule ]
]

{ #category : 'registration' }
CIWorkbookGadgetData class >> registerFamily: family variants: specs in: catalog [
	| variants |
	variants := specs
			collect: [ :spec | 
				CIGadgetVariantDefinition
					family: family
					variant: spec first
					tracks: (spec fourth
							collect: [ :row | CIGadgetStatTrack fromWorkbookRow: row ])
					overcharge: spec second
					expertise: spec third ].
	catalog
		registerGadgetFamily: (CIGadgetFamilyDefinition named: family variants: variants)
]

