		in: catalog.
	self
		registerFamily: 'Hive'
		variants: self hiveVariants
		in: catalog.
	self
		registerFamily: 'Chem Launcher'
		variants: self chemlauncherVariants
		in: catalog.
	self
		registerFamily: 'Firefly'
		variants: self fireflyVariants
		in: catalog.
	self
		registerFamily: 'Seeker'
		variants: self seekerVariants
		in: catalog.
	self
