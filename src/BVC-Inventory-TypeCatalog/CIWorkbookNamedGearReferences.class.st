		do: [ :spec | catalog registerNamedGearReference: (CINamedGearReference fromWorkbookRow: spec) ].
	self namedPart2
		do: [ :spec | catalog registerNamedGearReference: (CINamedGearReference fromWorkbookRow: spec) ].
	self namedPart3
